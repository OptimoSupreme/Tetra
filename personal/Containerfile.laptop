FROM quay.io/fedora/fedora-bootc:latest

# ==============================================================================
# Base Image & Core Packages
# ==============================================================================
# Base workstation image
# Install fastfetch, config, GNOME Desktop, and cursor theme
RUN dnf install -y fastfetch git breeze-cursor-theme ImageMagick \
    @workstation-product-environment && \
    dnf remove -y gnome-contacts gnome-weather gnome-clocks mediawriter gnome-maps 'libreoffice*' gnome-boxes gnome-connections snapshot gnome-characters gnome-font-viewer gnome-logs gnome-tour yelp ptyxis && \
    git clone https://github.com/OptimoSupreme/fastfetch_config /etc/skel/.config/fastfetch && \
    systemctl enable gdm.service

# ==============================================================================
# System Configuration
# ==============================================================================
# Rename OS in GRUB and Fastfetch
RUN sed -i 's/^PRETTY_NAME=.*/PRETTY_NAME="Tetra"/; s/^NAME=.*/NAME="Tetra"/' /usr/lib/os-release
# Apply global GNOME dconf settings and wallpaper
RUN rm -rf /usr/share/backgrounds/*
COPY global_assets/wallpaper.png /usr/share/backgrounds/default.png
COPY global_assets/dconf-profile /etc/dconf/profile/user
COPY global_assets/dconf-settings /etc/dconf/db/local.d/00-custom
RUN dconf update && \
    mkdir -p /usr/share/icons/default && \
    echo -e "[Icon Theme]\nInherits=Breeze_Light" > /usr/share/icons/default/index.theme && \
    mkdir -p /usr/share/glib-2.0/schemas && \
    echo -e "[org.gnome.desktop.interface]\ncursor-theme='Breeze_Light'\ncolor-scheme='prefer-dark'" > /usr/share/glib-2.0/schemas/99-custom-cursor.gschema.override && \
    glib-compile-schemas /usr/share/glib-2.0/schemas/

# Set Hostname
RUN echo "nazgul" > /etc/hostname

# Replace Plymouth spinner with custom trademark and remove watermark (if plymouth is installed)
COPY global_assets/trademark.png /tmp/trademark.png
RUN if [ -d /usr/share/plymouth/themes/spinner ]; then \
    rm -f /usr/share/plymouth/themes/spinner/watermark.png && \
    for i in $(seq -w 1 30); do \
    cp /tmp/trademark.png /usr/share/plymouth/themes/spinner/throbber-00$i.png || true; \
    done; \
    fi

# ==============================================================================
# Package Modifications
# ==============================================================================
# Add polkit rule to prevent "Authentication is required to update software" popups
# Disable systemd-remount-fs.service to prevent failure on read-only bootc systems
# Enable bootc-fetch-apply-updates.timer to automatically pull and stage system updates
COPY global_assets/10-packagekit-noauth.rules /etc/polkit-1/rules.d/
RUN systemctl mask systemd-remount-fs.service packagekit.service packagekit-offline-update.service && \
    systemctl enable bootc-fetch-apply-updates.timer

# Enable third party repos by default
RUN mkdir -p /etc/xdg/gnome-software && \
    cat > /etc/xdg/gnome-software/gnome-software-local.cfg <<EOF
[GNOME Software]
ShowRequiresRestart=true
ShowThirdPartyRepos=true
ShowUpgradeThirdPartyReleases=true
EOF

# Install RPM Fusion free & nonfree repos
RUN dnf install -y \
    https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-$(rpm -E %fedora).noarch.rpm \
    https://mirrors.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-$(rpm -E %fedora).noarch.rpm

# Install ghostty terminal emulator
RUN dnf copr enable -y scottames/ghostty && \
    dnf install -y ghostty

# Configure Ghostty with darker theme and bypassing fastfetch on secondary shells
COPY global_assets/ghostty/config /etc/ghostty/config
COPY global_assets/ghostty/bashrc_bypass /etc/ghostty/bashrc_bypass

# Switch to full ffmpeg and install additional multimedia codecs
RUN dnf swap -y ffmpeg-free ffmpeg --allowerasing && \
    dnf update -y @multimedia --setopt="install_weak_deps=False" --exclude=PackageKit-gstreamer-plugin

# Install Intel hardware acceleration codecs
RUN dnf install -y intel-media-driver

# ==============================================================================
# User Environment
# ==============================================================================
# Add configurations and packages for personal computers here

# Run fastfetch on login
RUN echo "fastfetch" >> /etc/bashrc

# Create user 'justin' with a password hash provided via build arg.
# To generate a secure hash, run: openssl passwd -6 "your_password"
# You can then pass it during build: podman build --build-arg PASSWORD_HASH="..."
ARG PASSWORD_HASH='$6$LbRJ9vDWbbOTSaba$MfApaj1PFMGL7R5CVGlR99jhTovgPktjE6c9xRf2G7D/rGDVPFARkoSHSGmaCG58vEG0MSUEWKHKMyLmFdtPy.'
RUN useradd -m -c "Justin" -G wheel -p "$PASSWORD_HASH" -s /bin/bash justin

# Set up profile picture for the user
# The profile.png image must exist in the personal/assets/ directory
COPY personal/assets/profile.png /var/lib/AccountsService/icons/justin
RUN mkdir -p /var/lib/AccountsService/users && \
    cat <<EOF > /var/lib/AccountsService/users/justin
[User]
Session=
Icon=/var/lib/AccountsService/icons/justin
SystemAccount=false
EOF

# ==============================================================================
# Housekeeping
# ==============================================================================
RUN dnf autoremove -y && \
    dnf clean all
