FROM quay.io/fedora/fedora-bootc:latest

# Base workstation image
# Install fastfetch, config, GNOME Desktop, and cursor theme
RUN dnf install -y fastfetch git breeze-cursor-theme \
    @workstation-product-environment && \
    dnf remove -y gnome-contacts gnome-weather gnome-clocks mediawriter gnome-maps 'libreoffice*' gnome-boxes gnome-connections snapshot gnome-characters gnome-font-viewer gnome-logs malcontent gnome-tour yelp && \
    dnf clean all && \
    git clone https://github.com/OptimoSupreme/fastfetch_config /etc/skel/.config/fastfetch && \
    systemctl enable gdm.service

# Apply global GNOME dconf settings and wallpaper
RUN rm -rf /usr/share/backgrounds/*
COPY global_assets/wallpaper.jpg /usr/share/backgrounds/default.jpg
COPY global_assets/dconf-profile /etc/dconf/profile/user
COPY global_assets/dconf-settings /etc/dconf/db/local.d/00-custom
RUN dconf update

# Add configurations and packages for personal computers here

# Install RPM Fusion free & nonfree repos
RUN dnf install -y \
    https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-$(rpm -E %fedora).noarch.rpm \
    https://mirrors.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-$(rpm -E %fedora).noarch.rpm && \
    dnf clean all

# Switch to full ffmpeg and install additional multimedia codecs
RUN dnf swap -y ffmpeg-free ffmpeg --allowerasing && \
    dnf update -y @multimedia --setopt="install_weak_deps=False" --exclude=PackageKit-gstreamer-plugin && \
    dnf clean all

# Install Intel hardware acceleration codecs
RUN dnf install -y intel-media-driver && \
    dnf clean all

# Create user 'justin' with a password hash provided via build arg.
# To generate a secure hash, run: openssl passwd -6 "your_password"
# You can then pass it during build: podman build --build-arg PASSWORD_HASH="..."
ARG PASSWORD_HASH='$6$LbRJ9vDWbbOTSaba$MfApaj1PFMGL7R5CVGlR99jhTovgPktjE6c9xRf2G7D/rGDVPFARkoSHSGmaCG58vEG0MSUEWKHKMyLmFdtPy.'
RUN useradd -m -c "Justin" -G wheel -p "$PASSWORD_HASH" -s /bin/bash justin

# Set up profile picture for the user
# The profile.png image must exist in the personal/assets/ directory
COPY personal/assets/profile.png /var/lib/AccountsService/icons/justin
RUN mkdir -p /var/lib/AccountsService/users && \
    cat <<EOF > /var/lib/AccountsService/users/justin
[User]
Session=
Icon=/var/lib/AccountsService/icons/justin
SystemAccount=false
EOF

# Set Hostname
RUN echo "nazgul" > /etc/hostname
