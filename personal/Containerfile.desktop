FROM quay.io/fedora/fedora-bootc:latest

# ==============================================================================
# Base Image & Core Packages
# ==============================================================================
# Base workstation image
# Install fastfetch, config, GNOME Desktop, and cursor theme
RUN dnf install -y fastfetch git breeze-cursor-theme ImageMagick corectrl btrfs-assistant \
    @workstation-product-environment && \
    dnf remove -y gnome-contacts gnome-weather gnome-clocks mediawriter gnome-maps 'libreoffice*' gnome-boxes gnome-connections snapshot gnome-characters gnome-font-viewer gnome-logs gnome-tour yelp ptyxis && \
    git clone https://github.com/OptimoSupreme/fastfetch_config /etc/skel/.config/fastfetch && \
    mkdir -p /etc/skel/.config/autostart && \
    cp /usr/share/applications/org.corectrl.CoreCtrl.desktop /etc/skel/.config/autostart/org.corectrl.CoreCtrl.desktop && \
    systemctl enable gdm.service

# ==============================================================================
# System Configuration
# ==============================================================================
# Name OS in GRUB and Fastfetch
RUN sed -i 's/^PRETTY_NAME=.*/PRETTY_NAME="Tetra"/; s/^NAME=.*/NAME="Tetra"/' /usr/lib/os-release
# Apply global GNOME dconf settings and wallpaper
RUN rm -rf /usr/share/backgrounds/*
COPY global_assets/wallpaper.png /usr/share/backgrounds/default.png
COPY global_assets/dconf-profile /etc/dconf/profile/user
COPY global_assets/dconf-settings /etc/dconf/db/local.d/00-custom
COPY personal/assets/dash-to-panel.conf /etc/dconf/db/local.d/01-dash-to-panel
COPY global_assets/90-corectrl.rules /etc/polkit-1/rules.d/90-corectrl.rules
COPY global_assets/amdgpu.toml /usr/lib/bootc/kargs.d/01-amdgpu.toml
RUN dconf update && \
    mkdir -p /usr/share/icons/default && \
    echo -e "[Icon Theme]\nInherits=Breeze_Light" > /usr/share/icons/default/index.theme && \
    mkdir -p /usr/share/glib-2.0/schemas && \
    echo -e "[org.gnome.desktop.interface]\ncursor-theme='Breeze_Light'\ncolor-scheme='prefer-dark'\n\n[org.gnome.login-screen]\nlogo='/usr/share/pixmaps/trademark.png'\n\n[org.gnome.shell.extensions.blur-my-shell.appfolder]\nstyle-dialogs=1\n\n[org.gnome.shell.extensions.blur-my-shell.dash-to-dock]\noverride-background=false\n\n[org.gnome.shell.extensions.blur-my-shell.panel]\noverride-background=false" > /usr/share/glib-2.0/schemas/99-custom.gschema.override && \
    glib-compile-schemas /usr/share/glib-2.0/schemas/

# Set Timezone and Enable Internet Time
RUN ln -fs /usr/share/zoneinfo/US/Eastern /etc/localtime && \
    systemctl enable chronyd

# Set Hostname
RUN echo "balrog" > /etc/hostname && \
    echo "f+ /etc/hostname 0644 root root - balrog" > /usr/lib/tmpfiles.d/10-set-hostname.conf

# Replace Plymouth spinner and GDM login screen with custom trademark
COPY global_assets/trademark.png /usr/share/pixmaps/trademark.png
RUN cp /usr/share/pixmaps/trademark.png /usr/share/fedora-logos/fedora_lightbackground.svg && \
    cp /usr/share/pixmaps/trademark.png /usr/share/fedora-logos/fedora_darkbackground.svg && \
    cp /usr/share/pixmaps/trademark.png /usr/share/fedora-logos/fedora_logo.svg && \
    cp /usr/share/pixmaps/trademark.png /usr/share/fedora-logos/fedora_logo_darkbackground.svg && \
    cp /usr/share/pixmaps/trademark.png /usr/share/pixmaps/fedora-gdm-logo.png && \
    cp /usr/share/pixmaps/trademark.png /usr/share/pixmaps/system-logo-white.png && \
    if [ -d /usr/share/plymouth/themes/spinner ]; then \
    rm -f /usr/share/plymouth/themes/spinner/watermark.png && \
    for i in $(seq -w 1 30); do \
    cp /usr/share/pixmaps/trademark.png /usr/share/plymouth/themes/spinner/throbber-00$i.png || true; \
    done; \
    fi

# ==============================================================================
# Package Modifications
# ==============================================================================
# Disable systemd-remount-fs.service and PackageKit update services to prevent failure on read-only bootc systems and silence auth popups
COPY global_assets/10-packagekit-noauth.rules /etc/polkit-1/rules.d/
RUN systemctl mask systemd-remount-fs.service packagekit.service packagekit-offline-update.service

# Install RPM Fusion free & nonfree repos
RUN dnf install -y \
    https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-$(rpm -E %fedora).noarch.rpm \
    https://mirrors.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-$(rpm -E %fedora).noarch.rpm

# Install ghostty terminal emulator
RUN dnf copr enable -y scottames/ghostty && \
    dnf install -y ghostty

# Configure Ghostty with darker theme
COPY global_assets/ghostty/config /etc/ghostty/config

# Switch to full ffmpeg and install additional multimedia codecs
RUN dnf swap -y ffmpeg-free ffmpeg --allowerasing && \
    dnf update -y @multimedia --setopt="install_weak_deps=False" --exclude=PackageKit-gstreamer-plugin

# Install AMD hardware acceleration codecs
RUN dnf swap -y mesa-va-drivers mesa-va-drivers-freeworld

# Install GNOME Extensions
RUN dnf install -y \
    gnome-shell-extension-appindicator \
    gnome-shell-extension-blur-my-shell \
    gnome-shell-extension-caffeine \
    gnome-shell-extension-dash-to-panel

# ==============================================================================
# User Environment
# ==============================================================================
# Add configurations and packages for personal computers here

# Run fastfetch on interactive shells, but only once per initialization
RUN echo 'if [[ $- == *i* ]] && [[ -z "$FASTFETCH_HAS_RUN" ]]; then FASTFETCH_HAS_RUN=1; fastfetch; fi' >> /etc/bashrc

# Create user 'justin' with a password hash provided via build arg.
# To generate a secure hash, run: openssl passwd -6 "your_password"
# You can then pass it during build: podman build --build-arg PASSWORD_HASH="..."
ARG PASSWORD_HASH='$6$LbRJ9vDWbbOTSaba$MfApaj1PFMGL7R5CVGlR99jhTovgPktjE6c9xRf2G7D/rGDVPFARkoSHSGmaCG58vEG0MSUEWKHKMyLmFdtPy.'
RUN useradd -m -c "Justin" -G wheel -p "$PASSWORD_HASH" -s /bin/bash justin

# Set up profile picture for the user
# The profile.png image must exist in the personal/assets/ directory
COPY personal/assets/profile.png /var/lib/AccountsService/icons/justin
RUN mkdir -p /var/lib/AccountsService/users && \
    cat <<EOF > /var/lib/AccountsService/users/justin
[User]
Session=
Icon=/var/lib/AccountsService/icons/justin
SystemAccount=false
EOF

# ==============================================================================
# Housekeeping
# ==============================================================================
RUN dnf autoremove -y && \
    dnf clean all
