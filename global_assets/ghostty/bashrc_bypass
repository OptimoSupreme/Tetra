# /etc/ghostty/bashrc_bypass
# This script bypasses the standard ~/.bashrc and sources system files 
# but specifically skips fastfetch for ghostty windows.

if [ -f /etc/bashrc ]; then
    . /etc/bashrc
fi

if [ -f ~/.bashrc ]; then
    . ~/.bashrc
fi

# Set an environment variable so nested shells know fastfetch ran
export FASTFETCH_RUN=1
