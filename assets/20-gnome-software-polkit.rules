// Allow users in the wheel group to perform rpm-ostree and flatpak actions without a password prompt
// This prevents GNOME Software from popping up authentication dialogs in the background

polkit.addRule(function(action, subject) {
    if ((action.id.indexOf("org.projectatomic.rpmostree1.") == 0 ||
         action.id.indexOf("org.freedesktop.Flatpak.") == 0) &&
        subject.active &&
        subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
