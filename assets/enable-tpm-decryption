#!/usr/bin/bash

# Ensure we're running as root
if [ "$EUID" -ne 0 ]; then
  echo "Please run this script as root (sudo enable-tpm-decryption)"
  exit 1
fi

echo "Locating LUKS encrypted root partition..."

# On ostree/composefs systems, the root (/) may not be on a block device directly.
# Check /sysroot first (where the actual disk is mounted), then fall back to /.
# Strip btrfs subvolume suffixes like [/root] from findmnt output.
SYSROOT_DEV=$(findmnt -n -o SOURCE /sysroot 2>/dev/null | sed 's/\[.*\]$//')
ROOT_DEV=$(findmnt -n -o SOURCE / | sed 's/\[.*\]$//')

if [[ "$SYSROOT_DEV" == /dev/mapper/* ]]; then
    MAPPER_NAME=$(basename "$SYSROOT_DEV")
    LUKS_DEV=$(cryptsetup status "$MAPPER_NAME" 2>/dev/null | grep 'device:' | awk '{print $2}')
elif [[ "$ROOT_DEV" == /dev/mapper/* ]]; then
    MAPPER_NAME=$(basename "$ROOT_DEV")
    LUKS_DEV=$(cryptsetup status "$MAPPER_NAME" 2>/dev/null | grep 'device:' | awk '{print $2}')
else
    # Fall back: find any active LUKS device on the system
    MAPPER_NAME=$(lsblk -ln -o NAME,TYPE | awk '$2 == "crypt" {print $1; exit}')
    if [[ -n "$MAPPER_NAME" ]]; then
        LUKS_DEV=$(cryptsetup status "$MAPPER_NAME" 2>/dev/null | grep 'device:' | awk '{print $2}')
    else
        LUKS_DEV=""
    fi
fi

# Check if it's actually a LUKS device
if [[ -z "$LUKS_DEV" ]] || ! cryptsetup isLuks "$LUKS_DEV" >/dev/null 2>&1; then
  echo "Error: Could not find a LUKS encrypted volume."
  echo "Are you sure you enabled encryption during installation?"
  exit 1
fi

echo "Found LUKS volume at: $LUKS_DEV"
echo "Enrolling TPM2 device..."

# Enroll the device using systemd-cryptenroll
# We bind to PCR 7 (Secure Boot state)
if systemd-cryptenroll --tpm2-device=auto --tpm2-pcrs=7 "$LUKS_DEV"; then
    echo ""
    echo "================================================================="
    echo "SUCCESS: TPM auto-unlock has been configured for $LUKS_DEV"
    echo "Your system should now decrypt automatically on the next reboot."
    echo "================================================================="
else
    echo "Error: Failed to enroll TPM. Please check the logs above."
    exit 1
fi
