[org/gnome/desktop/interface]
cursor-theme='Breeze_Light'
color-scheme='prefer-dark'
accent-color='orange'

[org/gnome/login-screen]
logo='/usr/share/pixmaps/trademark.png'
cursor-theme='Breeze_Light'
font-antialiasing='rgba'
clock-format='12h'
show-battery-percentage=true
color-scheme='prefer-dark'
accent-color='orange'

[org/gnome/desktop/wm/preferences]
button-layout='appmenu:minimize,close'

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/default.png'
picture-uri-dark='file:///usr/share/backgrounds/default.png'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/default.png'

[org/gnome/settings-daemon/plugins/color]
night-light-enabled=true
night-light-schedule-automatic=true
night-light-temperature=uint32 4000

[org/gnome/shell]
favorite-apps=['org.gnome.Nautilus.desktop', 'org.mozilla.firefox.desktop']
app-picker-layout=[{'org.gnome.Software.desktop': <{'position': <0>}>, 'org.gnome.Calendar.desktop': <{'position': <1>}>, 'org.gnome.Calculator.desktop': <{'position': <2>}>, 'org.gnome.SimpleScan.desktop': <{'position': <3>}>, 'Utilities': <{'position': <4>}>}]

[org/gnome/desktop/app-folders]
folder-children=['Utilities']

[org/gnome/desktop/app-folders/folders/Utilities]
name='Utilities'
apps=['org.gnome.DiskUtility.desktop', 'org.gnome.baobab.desktop', 'btrfs-assistant.desktop', 'org.gnome.SystemMonitor.desktop', 'org.gnome.Ptyxis.desktop', 'org.freedesktop.GnomeAbrt.desktop', 'org.gnome.Settings.desktop', 'org.gnome.TextEditor.desktop', 'org.gnome.Papers.desktop', 'org.gnome.Loupe.desktop', 'org.gnome.Decibels.desktop', 'org.gnome.Showtime.desktop']

[org/gnome/shell/app-switcher]
current-workspace-only=true

[org/gnome/desktop/search-providers]
sort-order=['org.gnome.Settings.desktop', 'org.gnome.Software.desktop']
disabled=['org.gnome.Nautilus.desktop', 'org.gnome.Calculator.desktop', 'org.gnome.Calendar.desktop', 'org.gnome.TextEditor.desktop', 'org.gnome.Console.desktop', 'org.gnome.Evince.desktop', 'org.gnome.Ptyxis.desktop']

[org/gnome/desktop/peripherals/mouse]
accel-profile='flat'

[org/gnome/system/location]
enabled=true

[org/gnome/desktop/privacy]
remember-recent-files=false
remove-old-trash-files=true
remove-old-temp-files=true
old-files-age=uint32 3

[org/gnome/Ptyxis]
use-system-font=false
font-name='Monospace 11'
cursor-shape='underline'
cursor-blink-mode='off'
audible-bell=false
default-profile-uuid='00000000-0000-0000-0000-000000000000'
profile-uuids=['00000000-0000-0000-0000-000000000000']

[org/gnome/Ptyxis/Profiles/00000000-0000-0000-0000-000000000000]
label='Default'
palette='Dark Pastel'
